# Copy this file to .env and fill in whichever keys you have.
# Providers are auto-selected from the keys present; set the *_PROVIDER vars to override.

# --- Free options ---
# Google AI Studio (free tier, no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (free tier, no card): https://console.groq.com/keys  -> fast story engine (gpt-oss-120b) + Whisper speech-to-text
GROQ_API_KEY=

# --- Paid, optional (best narration voice, ~10-15 cents per story) ---
OPENAI_API_KEY=

# Story engine: openai | groq | gemini | mock   (auto-picks in that order; mock = scripted offline demo)
LLM_PROVIDER=
# Optional model override (defaults: gpt-5.4-mini on openai, openai/gpt-oss-120b on groq, gemini-3.5-flash). Other keys are used as automatic fallbacks.
LLM_MODEL=

# Speech-to-text: groq | openai | browser   (browser = Chrome's built-in Web Speech API)
STT_PROVIDER=

# Text-to-speech: openai | browser   (browser = built-in system voices, free)
TTS_PROVIDER=
TTS_VOICE=sage

PORT=8787
